# First start only (or an explicit offline -reset-passwords). Saved passwords
# take precedence on later starts; these values can then be removed.
CODEX_DM_PASSWORD=replace-with-a-long-random-password
CODEX_PLAYER_PASSWORD=
CODEX_SECURE_COOKIES=true
CODEX_LOCALE=en
CODEX_TIME_ZONE=Europe/Prague

# Optional GitHub fallback. Settings > Add-ons manages stored default and
# repository-specific tokens, which take precedence over this value.
CODEX_GITHUB_TOKEN=

# Keep the selected build after healthy startup/activation (default true).
# Retire old packages and their add-on recovery data; preserve campaign recovery,
# current saves and existing full backup ZIPs.
CODEX_ADDON_AUTO_CLEANUP=true
# Optional historical add-on recovery: retain metadata and offline-only copies.
CODEX_ADDON_KEEP_RECOVERY_PACKAGES=false
