{
  "name": "ttrpg-codex",
  "version": "1.3.0",
  "description": "Self-hostable web codex for D&D and other TTRPGs",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/**/*.test.*js\"",
    "test:ci": "node --test --test-concurrency=4 \"test/**/*.test.*js\"",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm test",
    "check:ci": "npm run lint && npm run test:ci"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0"
  }
}
