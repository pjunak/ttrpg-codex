    "leaflet": "1.9.4",
    "lit": "3.3.3",
    "marked": "18.0.11"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "playwright": "1.62.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
