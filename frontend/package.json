{
  "name": "@ttrpg-codex/frontend",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p ../tsconfig.node.json",
    "test": "vitest run",
    "test:browser": "npm run build && node --test --test-concurrency=4 test/browser/*.browser.mts",
    "test:installed": "node --test --test-concurrency=4 test/browser/installed-*.browser.mts",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "leaflet": "1.9.4",
    "lit": "3.3.3",
    "marked": "18.1.2",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
