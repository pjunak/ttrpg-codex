{
  "name": "@ttrpg-codex/frontend",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p ../tsconfig.node.json",
    "test": "vitest run",
    "test:browser": "npm run build && node --test test/browser/*.browser.mts",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "leaflet": "1.9.4",
    "lit": "3.3.3",
    "marked": "18.0.11",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.7",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.3"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "26.5.1",
    "playwright": "1.62.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
