# Runtime state — lives in volumes, never in the image. The data dir
# also contains auth.json (password hashes) and campaign content; keep
# it out of the build context so a future `COPY . .` can't leak it.
data/
data-snapshots/

# Dev-only dependencies and generated output.
node_modules/
frontend/node_modules/
frontend/dist/
.git/
.github/
test/
examples/
scripts/
.env*
docs/
output/
release/
.codex/
.claude/
**/test-results/
**/playwright-report/
*.bundle
*.log
