{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junak.eu/ttrpg-codex/contracts/addons/v3/protocol.schema.json",
  "title": "TTRPG Codex Add-on Worker Protocol Envelope v1",
  "description": "One decoded JSON-RPC 2.0 message. Batch messages are not supported.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/notification" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "id": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        { "type": "integer" }
      ]
    },
    "params": {
      "oneOf": [
        { "type": "object" },
        { "type": "array" }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": {
          "enum": ["dm", "player", "system"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "correlationId", "generation", "deadline"],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "traceparent": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "params": { "$ref": "#/$defs/params" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "params": { "$ref": "#/$defs/params" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": true,
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "appError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message", "retryable"],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        },
        "details": true
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "data": {
          "$ref": "#/$defs/appError"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "error": { "$ref": "#/$defs/error" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    }
  }
}
